# Optional local overrides. A session and workspace are created automatically.
VERIDEX_BASE_URL=http://127.0.0.1:8765
VERIDEX_CODEX_TOKEN=
VERIDEX_AUTOSTART=true
# Optional: full lets Codex search and work with files anywhere on this computer.
VERIDEX_CODEX_ACCESS_MODE=read_only
# Optional free-only Art Studio providers. Keep Cloudflare on Workers Free.
VERIDEX_CLOUDFLARE_ACCOUNT_ID=
VERIDEX_CLOUDFLARE_API_TOKEN=
VERIDEX_POLLINATIONS_API_KEY=
VERIDEX_REALESRGAN_PATH=
# Optional dedicated Instagram bridge. Keep real credentials only in .env.local.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
VERIDEX_INSTAGRAM_PROFILE_DIR=C:\codex2veridex\data\browser_profiles\veridex_instagram
VERIDEX_INSTAGRAM_DEBUG_PORT=9224
# Optional dedicated Facebook bridge. Keep real credentials only in local.env or .env.local.
FACEBOOK_USERNAME=
FACEBOOK_PASSWORD=
VERIDEX_FACEBOOK_PROFILE_DIR=C:\codex2veridex\data\browser_profiles\veridex_facebook
VERIDEX_FACEBOOK_DEBUG_PORT=9225
# Optional eBay Sell API connection. Keep the client secret and tokens local.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_REDIRECT_URI=http://127.0.0.1:8079/integrations/ebay/callback
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE_ID=EBAY_US
VERIDEX_INTEGRATION_ENCRYPTION_KEY=
