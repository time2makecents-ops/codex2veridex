{
  "manifest_version": 3,
  "name": "Veridex Browser Companion",
  "version": "0.1.2",
  "key": "",
  "description": "Explicit tab selection and locally approved browser actions through Veridex.",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service_worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Veridex Browser Companion"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
